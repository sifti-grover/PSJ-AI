# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-too
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
EXECUTIONS_MODE=queue

# --- Postgres (shared by n8n queue mode + app schema) ---
POSTGRES_USER=veritas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=veritas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (n8n queue mode) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Qdrant (Layer 6: retrieval grounding) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=veritas_documents

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- NVIDIA NIM (build.nvidia.com or self-hosted) ---
# OpenAI-compatible endpoint; used for NeMo Retriever embeddings/reranking
# and optionally as a second consensus model.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_NIM_RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# --- Optional: live Scopus query ingestion ---
SCOPUS_API_KEY=
